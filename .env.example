# Local dev — same-site with backend (both on localhost), so an absolute
# cross-port URL is fine here.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel (staging/production) only — see next.config.ts's rewrites().
# NEXT_PUBLIC_API_URL must be the *relative* path "/api/v1" there (not an
# absolute Railway URL) so the browser only ever talks to this app's own
# origin; the refresh-token cookie is sameSite:"strict" and won't survive
# a truly cross-site request. BACKEND_ORIGIN (server-only, no NEXT_PUBLIC_
# prefix) is what next.config.ts proxies /api/v1/* to.
# NEXT_PUBLIC_API_URL=/api/v1
# NEXT_PUBLIC_SITE_URL=https://<this-app's-vercel-domain>
# BACKEND_ORIGIN=https://<railway-backend>.up.railway.app
